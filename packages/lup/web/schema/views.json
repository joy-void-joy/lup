{
  "$defs": {
    "EdgeCount": {
      "additionalProperties": false,
      "description": "How many edges of one kind point at a node \u2014 its weight in the log.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "EdgeCount",
      "type": "object"
    },
    "EdgeView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "target"
      ],
      "title": "EdgeView",
      "type": "object"
    },
    "ExportView": {
      "additionalProperties": false,
      "description": "Everything a standalone page needs, so it opens with no server behind it.\n\nThe graph, every node's detail and the declared kinds, because a page\nopened from a file cannot ask for more later \u2014 the worked example this\ncame from was an 18 MB single file for exactly this reason, and a memo\nattachment that needed a server would not be one. Stamped with the moment\nit was taken, since what it shows is the log as it was then.",
      "properties": {
        "details": {
          "items": {
            "$ref": "#/$defs/NodeDetail"
          },
          "title": "Details",
          "type": "array"
        },
        "exported_at": {
          "format": "date-time",
          "title": "Exported At",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/GraphView"
        },
        "kinds": {
          "$ref": "#/$defs/KindsView"
        }
      },
      "required": [
        "graph",
        "details",
        "kinds",
        "exported_at"
      ],
      "title": "ExportView",
      "type": "object"
    },
    "GraphView": {
      "additionalProperties": false,
      "description": "The whole log as a graph, with the vocabularies a reader filters by.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "standings": {
          "items": {
            "type": "string"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "kinds",
        "standings"
      ],
      "title": "GraphView",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "KindInfo": {
      "additionalProperties": false,
      "description": "One declared kind: its name, what it is for, and what it accepts.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "summary",
        "fields"
      ],
      "title": "KindInfo",
      "type": "object"
    },
    "KindsView": {
      "additionalProperties": false,
      "description": "What a project declares: its node kinds and its relations, with their fields.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/KindInfo"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/KindInfo"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "KindsView",
      "type": "object"
    },
    "NodeDetail": {
      "additionalProperties": false,
      "description": "One node in full: its own fields, its weight, and every edge in and out.",
      "properties": {
        "attachments": {
          "items": {
            "type": "string"
          },
          "title": "Attachments",
          "type": "array"
        },
        "edges_in": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges In",
          "type": "array"
        },
        "edges_out": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges Out",
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/JsonObject"
        },
        "incoming": {
          "items": {
            "$ref": "#/$defs/EdgeCount"
          },
          "title": "Incoming",
          "type": "array"
        },
        "node": {
          "$ref": "#/$defs/NodeView"
        }
      },
      "required": [
        "node",
        "fields",
        "incoming",
        "edges_in",
        "edges_out",
        "attachments"
      ],
      "title": "NodeDetail",
      "type": "object"
    },
    "NodeView": {
      "additionalProperties": false,
      "description": "One node as a reader meets it: what it is and where it stands right now.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "moved": {
          "format": "date-time",
          "title": "Moved",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "slug": {
          "default": "",
          "title": "Slug",
          "type": "string"
        },
        "sound": {
          "default": true,
          "title": "Sound",
          "type": "boolean"
        },
        "standing": {
          "title": "Standing",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "slug",
        "text",
        "priority",
        "standing",
        "reason",
        "sound",
        "moved"
      ],
      "title": "NodeView",
      "type": "object"
    }
  },
  "title": "LupViews"
}
