{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "description": "One value that came back, against the field that asked for it.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Answer",
      "type": "object"
    },
    "EdgeCount": {
      "additionalProperties": false,
      "description": "How many edges of one kind point at a node \u2014 its weight in the log.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "EdgeCount",
      "type": "object"
    },
    "EdgeView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "target"
      ],
      "title": "EdgeView",
      "type": "object"
    },
    "ExportView": {
      "additionalProperties": false,
      "description": "Everything a standalone page needs, so it opens with no server behind it.\n\nThe graph, every node's detail and the declared kinds, because a page\nopened from a file cannot ask for more later \u2014 the worked example this\ncame from was an 18 MB single file for exactly this reason, and a memo\nattachment that needed a server would not be one. Stamped with the moment\nit was taken, since what it shows is the log as it was then.",
      "properties": {
        "details": {
          "items": {
            "$ref": "#/$defs/NodeDetail"
          },
          "title": "Details",
          "type": "array"
        },
        "exported_at": {
          "format": "date-time",
          "title": "Exported At",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/GraphView"
        },
        "kinds": {
          "$ref": "#/$defs/KindsView"
        }
      },
      "required": [
        "graph",
        "details",
        "kinds",
        "exported_at"
      ],
      "title": "ExportView",
      "type": "object"
    },
    "GraphView": {
      "additionalProperties": false,
      "description": "The whole log as a graph, with the vocabularies a reader filters by.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "standings": {
          "items": {
            "type": "string"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "kinds",
        "standings"
      ],
      "title": "GraphView",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "KindInfo": {
      "additionalProperties": false,
      "description": "One declared kind: its name, what it is for, and what it accepts.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "summary",
        "fields"
      ],
      "title": "KindInfo",
      "type": "object"
    },
    "KindsView": {
      "additionalProperties": false,
      "description": "What a project declares: its node kinds and its relations, with their fields.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/KindInfo"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/KindInfo"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "KindsView",
      "type": "object"
    },
    "NodeDetail": {
      "additionalProperties": false,
      "description": "One node in full: its own fields, its weight, and every edge in and out.",
      "properties": {
        "attachments": {
          "items": {
            "type": "string"
          },
          "title": "Attachments",
          "type": "array"
        },
        "edges_in": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges In",
          "type": "array"
        },
        "edges_out": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges Out",
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/JsonObject"
        },
        "incoming": {
          "items": {
            "$ref": "#/$defs/EdgeCount"
          },
          "title": "Incoming",
          "type": "array"
        },
        "node": {
          "$ref": "#/$defs/NodeView"
        }
      },
      "required": [
        "node",
        "fields",
        "incoming",
        "edges_in",
        "edges_out",
        "attachments"
      ],
      "title": "NodeDetail",
      "type": "object"
    },
    "NodeView": {
      "additionalProperties": false,
      "description": "One node as a reader meets it: what it is and where it stands right now.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "moved": {
          "format": "date-time",
          "title": "Moved",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "slug": {
          "default": "",
          "title": "Slug",
          "type": "string"
        },
        "sound": {
          "default": true,
          "title": "Sound",
          "type": "boolean"
        },
        "standing": {
          "title": "Standing",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "slug",
        "text",
        "priority",
        "standing",
        "reason",
        "sound",
        "moved"
      ],
      "title": "NodeView",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "description": "One thing a listing step lists, and what may be done to it.",
      "properties": {
        "acts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RowAct"
          },
          "title": "Acts",
          "type": "array"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "stream": {
          "default": "",
          "title": "Stream",
          "type": "string"
        }
      },
      "required": [
        "name",
        "detail",
        "acts",
        "stream"
      ],
      "title": "Row",
      "type": "object"
    },
    "RowAct": {
      "additionalProperties": false,
      "description": "One verb offered against one row.\n\nThe same shape a terminal menu draws, so a surface cannot offer a verb the\nother surface does not have.",
      "properties": {
        "asks": {
          "default": "",
          "title": "Asks",
          "type": "string"
        },
        "consequence": {
          "title": "Consequence",
          "type": "string"
        },
        "destructive": {
          "default": false,
          "title": "Destructive",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "label",
        "consequence",
        "asks",
        "destructive"
      ],
      "title": "RowAct",
      "type": "object"
    },
    "RowRequest": {
      "additionalProperties": false,
      "description": "Which of a row's acts somebody clicked, and the one value it asked for.",
      "properties": {
        "act": {
          "default": "",
          "title": "Act",
          "type": "string"
        },
        "answer": {
          "default": "",
          "title": "Answer",
          "type": "string"
        },
        "row": {
          "default": "",
          "title": "Row",
          "type": "string"
        }
      },
      "required": [
        "row",
        "act",
        "answer"
      ],
      "title": "RowRequest",
      "type": "object"
    },
    "ScopeChoice": {
      "additionalProperties": false,
      "description": "One of the things this wizard can be pointed at.",
      "properties": {
        "chosen": {
          "default": false,
          "title": "Chosen",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "detail",
        "chosen"
      ],
      "title": "ScopeChoice",
      "type": "object"
    },
    "ScopeRequest": {
      "additionalProperties": false,
      "description": "A scope somebody asked to make.",
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ScopeRequest",
      "type": "object"
    },
    "StepAnswers": {
      "additionalProperties": false,
      "description": "Everything a page submitted for one step.\n\nA list of named answers rather than a bare mapping: what arrives on a\nsocket is untrusted, and a shape says which keys were expected where a\nmapping would take any of them.",
      "properties": {
        "answers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "title": "Answers",
          "type": "array"
        }
      },
      "required": [
        "answers"
      ],
      "title": "StepAnswers",
      "type": "object"
    },
    "StepField": {
      "additionalProperties": false,
      "description": "One value a step asks for.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "placeholder": {
          "default": "",
          "title": "Placeholder",
          "type": "string"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "placeholder",
        "secret"
      ],
      "title": "StepField",
      "type": "object"
    },
    "StepKind": {
      "enum": [
        "form",
        "rows"
      ],
      "type": "string"
    },
    "StepOutcome": {
      "additionalProperties": false,
      "description": "What running, testing, or undoing a step did.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "message"
      ],
      "title": "StepOutcome",
      "type": "object"
    },
    "StepReply": {
      "additionalProperties": false,
      "description": "What an act did, and the page as it stands afterwards.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/StepOutcome"
        },
        "view": {
          "$ref": "#/$defs/WizardView"
        }
      },
      "required": [
        "outcome",
        "view"
      ],
      "title": "StepReply",
      "type": "object"
    },
    "StepStanding": {
      "additionalProperties": false,
      "description": "Where a step stands right now.\n\n``done`` and ``offered`` are separate because they answer different\nquestions and disagree in both directions: a finished step is still\noffered when redoing it is how a wrong answer gets fixed, and an unfinished\none is withheld while the step before it is unanswered.",
      "properties": {
        "blocked": {
          "default": "",
          "title": "Blocked",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        },
        "offered": {
          "default": true,
          "title": "Offered",
          "type": "boolean"
        }
      },
      "required": [
        "done",
        "detail",
        "offered",
        "blocked"
      ],
      "title": "StepStanding",
      "type": "object"
    },
    "StepView": {
      "additionalProperties": false,
      "description": "One step as the page draws it: the declaration, plus where it stands.",
      "properties": {
        "blurb": {
          "default": "",
          "title": "Blurb",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StepField"
          },
          "title": "Fields",
          "type": "array"
        },
        "guide": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Guide",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "default": "form"
        },
        "numbered": {
          "default": true,
          "title": "Numbered",
          "type": "boolean"
        },
        "opens": {
          "default": "",
          "title": "Opens",
          "type": "string"
        },
        "rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Row"
          },
          "title": "Rows",
          "type": "array"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "standing": {
          "$ref": "#/$defs/StepStanding",
          "default": {
            "blocked": "",
            "detail": "",
            "done": false,
            "offered": true
          }
        },
        "submit": {
          "default": "Save",
          "title": "Submit",
          "type": "string"
        },
        "tests": {
          "default": "",
          "title": "Tests",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "undoes": {
          "default": "",
          "title": "Undoes",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title",
        "blurb",
        "guide",
        "numbered",
        "opens",
        "kind",
        "fields",
        "submit",
        "standing",
        "rows",
        "tests",
        "undoes"
      ],
      "title": "StepView",
      "type": "object"
    },
    "WizardView": {
      "additionalProperties": false,
      "description": "Everything the page needs to draw itself, in one reply.",
      "properties": {
        "chosen": {
          "default": "",
          "title": "Chosen",
          "type": "string"
        },
        "create_asks": {
          "default": "",
          "title": "Create Asks",
          "type": "string"
        },
        "creates": {
          "default": "",
          "title": "Creates",
          "type": "string"
        },
        "lede": {
          "default": "",
          "title": "Lede",
          "type": "string"
        },
        "notice": {
          "default": "",
          "title": "Notice",
          "type": "string"
        },
        "scope_label": {
          "default": "",
          "title": "Scope Label",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScopeChoice"
          },
          "title": "Scopes",
          "type": "array"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StepView"
          },
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "lede",
        "scope_label",
        "scopes",
        "chosen",
        "steps",
        "creates",
        "create_asks",
        "notice"
      ],
      "title": "WizardView",
      "type": "object"
    }
  },
  "title": "LupViews"
}
