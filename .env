# Template defaults -- override in .env.local (gitignored)

# Optional - Model settings (defaults: opus 4.6, 128k-1 thinking tokens)
# AGENT_MODEL=claude-opus-4-6
# AGENT_MAX_THINKING_TOKENS=127999
# AGENT_MAX_BUDGET_USD=5.00
# AGENT_MAX_TURNS=50
# AGENT_HTTP_TIMEOUT_SECONDS=30

# Optional - Codex/OpenAI backend pricing (required for AGENT_MAX_BUDGET_USD
# on AGENT_SDK=codex/openai: the Codex SDK reports tokens, not cost)
# CODEX_USD_PER_MTOK_INPUT=1.25
# CODEX_USD_PER_MTOK_OUTPUT=10.00
# CODEX_USD_PER_MTOK_CACHED_INPUT=0.125

# Optional - Paths
# AGENT_NOTES_PATH=./notes
# AGENT_LOGS_PATH=./logs

# Domain-specific API keys (add as needed)
# EXA_API_KEY=your-exa-key
# FRED_API_KEY=your-fred-key
