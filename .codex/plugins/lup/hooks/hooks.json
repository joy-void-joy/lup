{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "sh \"$PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "statusMessage": "Checking Lup policy",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|web_fetch|apply_patch|Artifact|Skill|EnterWorktree"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "statusMessage": "Checking Lup policy",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "apply_patch|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "statusMessage": "Checking Lup policy",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|web_fetch|apply_patch|Artifact|Skill|EnterWorktree"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"$PLUGIN_ROOT/hooks/scripts/coordination_changes.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
