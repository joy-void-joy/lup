{
  "autoMemoryEnabled": false,
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(uv run python packages/lup-dev/checker/build.py:*)",
      "Bash(uv run packages/lup-dev/checker/build.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree list:*)",
      "Bash(git -C /home/pfftz/job/onit/lup.git/tree/dev merge --no-ff:*)",
      "Bash(git -C /home/pfftz/job/onit/lup.git/tree/dev push origin dev)"
    ],
    "ask": ["Bash(gh pr merge:*)"],
    "deny": ["Artifact", "SendFeedback", "Workflow", "ScheduleWakeup", "ReportFindings"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(uv tool dir --bin)/lup-dev\" hook claude",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(uv tool dir --bin)/lup-dev\" hook claude",
            "timeout": 600,
            "statusMessage": "lup is checking this write against its rules"
          }
        ]
      }
    ]
  }
}
