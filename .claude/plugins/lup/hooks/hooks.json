{
  "description": "Lup semantic permission policy",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch|Edit|Write|Artifact|Skill|EnterWorktree"
      }
    ]
  }
}
