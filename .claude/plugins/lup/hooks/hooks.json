{
  "description": "Lup semantic permission policy, peer delivery, and the roster's changes at each prompt",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch|Edit|Write|SendMessage|ListAgents|Artifact|Skill|EnterWorktree"
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_delivery.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_changes.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
