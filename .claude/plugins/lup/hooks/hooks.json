{
  "description": "Lup semantic permission policy",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.py\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.py\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch|Edit|Write|Artifact|Skill|EnterWorktree"
      }
    ]
  }
}
