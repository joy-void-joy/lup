{
    // `pyright` links to pyright's source at the release the engine is built from,
    // kept outside the repository, beside the build (`lup_code_rules/environment/build.py`).
    // The build hands this file to the bundler explicitly.
    "extends": "./pyright/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "paths": {
            "pyright/*": ["./pyright/packages/pyright-internal/src/*"]
        },
        "typeRoots": [
            "./pyright/packages/pyright-internal/node_modules/@types",
            "./pyright/packages/pyright-internal/typings"
        ]
    },
    "include": ["src/**/*.ts"]
}
